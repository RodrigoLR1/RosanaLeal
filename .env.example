# =============================================================
# Rosana Leal Rodrigues · Nutrifarma — variáveis de ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha os valores.
# As variáveis NEXT_PUBLIC_* ficam expostas no browser.

# URL canônica do site (sem barra no final).
# Usada em metadata, JSON-LD, sitemap, robots e OG.
NEXT_PUBLIC_SITE_URL=https://rosanalealnutri.com.br

# -----------------------------------------------------------
# Tracking (opcional — atualmente em STANDBY, ativar quando
# a cliente decidir rodar campanhas)
# -----------------------------------------------------------
# Se as 3 variáveis abaixo ficarem vazias, os scripts de
# tracking simplesmente não são injetados na página.

# Meta (Facebook) Pixel ID — Business Manager → Eventos → Pixel.
# Formato: 15-16 dígitos.
# NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads ID — Google Ads → Ferramentas → Conversões → Tag.
# Formato: AW-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion label do Google Ads — usado para reportar a
# conversão "Lead via WhatsApp". Encontra-se no detalhe da
# conversão criada no Google Ads.
# Formato: alfanumérico curto.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Google Analytics 4 (GA4) Measurement ID.
# Formato: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
